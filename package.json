{
  "name": "@nio-fe/lego-monorepo-workspace",
  "private": true,
  "engines": {
    "node": "20",
    "pnpm": "9"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky install && ts-patch install -s",
    "build": "pnpm setVersion && pnpm --filter doc... build",
    "dev:slow": "pnpm --filter doc dev",
    "dev:fast": "pnpm --filter doc dev:fast",
    "new": "bun run scripts/new/index.ts",
    "lint": "bun oxlint && bun eslint --fix --ext .ts,.tsx ./packages",
    "preinstall": "bun run scripts/init.ts",
    "gitcase": "git config core.ignorecase false",
    "modify:version": "bun run scripts/modifyVersion.ts",
    "pub": "sucrase-node scripts/publish.ts",
    "setVersion": "bun run scripts/setVersionFile.ts",
    "vitest:all": "pnpm vitest:lego && pnpm vitest:unplugin-resolver && pnpm vitest:colors",
    "vitest:lego": "vitest run --dir ./packages/lego/src --config ./packages/lego/vitest.config.ts",
    "vitest:unplugin-resolver": "vitest run --dir ./packages/unplugin-resolver --config ./packages/unplugin-resolver/vitest.config.ts",
    "vitest:colors": "vitest run --dir ./packages/colors/src --config ./packages/colors/vite.config.ts",
    "git:prune": "git remote prune origin && git branch -vv | grep 'origin/.*: gone]' | awk '{print $1}' | xargs git branch -d",
    "docs:dev": "vitepress dev packages/docs",
    "docs:build": "vitepress build packages/docs",
    "docs:preview": "vitepress preview packages/docs"
  },
  "devDependencies": {
    "@babel/core": "^7.16.10",
    "@babel/plugin-transform-runtime": "^7.17.0",
    "@babel/preset-env": "^7.16.7",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@commitlint/cli": "^17.6.7",
    "@commitlint/config-conventional": "^17.6.7",
    "@nio-fe/eslint-plugin-lego": "workspace:*",
    "@nio-fe/lego": "workspace:*",
    "@rollup/plugin-alias": "^3.1.9",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@rollup/pluginutils": "^4.1.2",
    "@types/css-tree": "^1.0.7",
    "@types/fs-extra": "^9.0.13",
    "@types/lodash": "^4.14.185",
    "@types/markdown-it": "^14.1.1",
    "@types/markdown-it-container": "^2.0.5",
    "@types/node": "^22.10.1",
    "@types/shelljs": "^0.8.11",
    "@types/vfile-message": "^2.0.0",
    "@types/webpack-env": "^1.16.3",
    "@types/yargs": "^17.0.13",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitejs/plugin-vue-jsx": "^4.1.0",
    "@vitest/browser": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/babel-plugin-jsx": "^1.1.1",
    "@vue/compiler-sfc": "^3.2.26",
    "@vue/component-compiler-utils": "^3.3.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/runtime-core": "^3.2.26",
    "@vue/runtime-dom": "^3.2.26",
    "@vue/test-utils": "^2.2.0",
    "babel-eslint": "^10.0.1",
    "chalk": "^4.1.2",
    "codemirror": "^6.0.1",
    "cpy": "^8.1.2",
    "css-tree": "^2.0.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-html": "^7.1.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-markdown": "^3.0.0",
    "eslint-plugin-no-explicit-type-exports": "^0.12.0",
    "eslint-plugin-oxlint": "^0.5.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^9.15.1",
    "fs-extra": "^10.0.0",
    "happy-dom": "^15.10.2",
    "husky": "^8.0.3",
    "jsdom": "^20.0.2",
    "lint-staged": "^13.2.3",
    "lodash": "^4.17.21",
    "markdown-it-container": "^3.0.0",
    "markdown-it-multimd-table": "^4.1.1",
    "oxlint": "^0.6.1",
    "postcss": "^8.4.19",
    "prettier": "^3.0.0",
    "pretty-quick": "^3.1.3",
    "resize-observer-polyfill": "^1.5.1",
    "rollup": "^2.64.0",
    "rollup-plugin-banner": "^0.2.1",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-scss": "^3.0.0",
    "rollup-plugin-typescript2": "^0.31.1",
    "rollup-plugin-visualizer": "^5.9.0",
    "rollup-plugin-vue": "^6.0.0",
    "sass": "^1.54.5",
    "shelljs": "^0.8.5",
    "stylelint": "^14.12.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recess-order": "^3.0.0",
    "stylelint-config-standard": "^28.0.0",
    "stylelint-config-standard-scss": "^5.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^2.7.0",
    "stylelint-order": "^5.0.0",
    "stylelint-scss": "^4.3.0",
    "sucrase": "^3.20.3",
    "transliteration": "^2.2.0",
    "ts-morph": "^15.1.0",
    "ts-node": "^10.4.0",
    "ts-patch": "^3.2.0",
    "tsc-alias": "^1.6.4",
    "typescript": "^5.7.2",
    "typescript-transform-paths": "^3.4.7",
    "unplugin-vue-components": "^0.22.11",
    "unplugin-vue-define-options": "^1.4.5",
    "vfile-message": "^3.1.4",
    "vite": "^5.4.6",
    "vite-plugin-prismjs": "^0.0.11",
    "vite-plugin-resolve-extension-vue": "^0.1.0",
    "vitepress": "^1.2.3",
    "vitest": "^0.34.2",
    "vue": "^3.2.47",
    "vue-router": "^4.0.12",
    "vue-template-compiler": "^2.7.16",
    "vue-tsc": "~1.6.4",
    "vue-types": "^5.1.2",
    "yargs": "^17.3.1"
  },
  "resolutions": {
    "vue": "3.2.47",
    "@vue/runtime-core": "3.2.47",
    "@vue/runtime-dom": "3.2.47",
    "@vue/compiler-core": "3.2.47",
    "@vue/compiler-dom": "3.2.47",
    "@vue/compiler-sfc": "3.2.47",
    "@vue/reactivity": "3.2.47",
    "@vue/shared": "3.2.47"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "**/*.ts?(x)": [
      "bun oxlint && bun eslint --fix"
    ],
    "**/*.scss": [
      "stylelint --fix"
    ]
  }
}
