{
  "name": "@aurora/horizon-web-monorepo-workspace",
  "private": true,
  "engines": {
    "node": ">= 20",
    "bun": ">= 1.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky install && ts-patch install -s",
    "build": "bun run setVersion && bun --filter '*' build",
    "build:theme": "bun --filter @aurora/horizon-web build:theme",
    "dev": "bun run docs:dev",
    "new": "bun run scripts/new/index.ts",
    "lint": "bunx oxlint && bun eslint --fix --ext .ts,.tsx ./packages",
    "preinstall": "bun run scripts/init.ts",
    "gitcase": "git config core.ignorecase false",
    "modify:version": "bun run scripts/modifyVersion.ts",
    "pub": "bun run scripts/publish.ts",
    "setVersion": "bun run scripts/setVersionFile.ts",
    "ts:probe:ts7": "bunx --bun typescript@7.0.2 --project packages/api-generator/tsconfig.json --noEmit --pretty false",
    "vitest:all": "bun run vitest:horizon-web && bun run vitest:unplugin-resolver && bun run vitest:colors",
    "vitest:horizon-web": "vitest run --dir ./packages/horizon-web/src --config ./packages/horizon-web/vitest.config.ts",
    "vitest:unplugin-resolver": "vitest run --dir ./packages/unplugin-resolver --config ./packages/unplugin-resolver/vitest.config.ts",
    "vitest:colors": "vitest run --dir ./packages/colors/src --config ./packages/colors/vite.config.ts",
    "git:prune": "git remote prune origin && git branch -vv | grep 'origin/.*: gone]' | awk '{print $1}' | xargs git branch -d",
    "docs:prepare": "bun --filter @aurora/api-generator build",
    "docs:dev": "bun run docs:prepare && vitepress dev packages/docs",
    "docs:build": "bun run docs:prepare && bun run docs:check-media && vitepress build packages/docs",
    "docs:check-media": "bun run scripts/checkDocsMedia.ts",
    "docs:preview": "vitepress preview packages/docs"
  },
  "devDependencies": {
    "@aurora/eslint-plugin-horizon-web": "workspace:*",
    "@aurora/horizon-web": "workspace:*",
    "@aurora/icon": "workspace:*",
    "@aurora/locale": "workspace:*",
    "@aurora/locale-vue": "workspace:*",
    "@aurora/utils": "workspace:*",
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@faker-js/faker": "^10.2.0",
    "@oxlint/migrate": "^1.33.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/pluginutils": "^5.3.0",
    "@types/css-tree": "^2.3.11",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.13",
    "@types/markdown-it": "^14.1.1",
    "@types/markdown-it-container": "^2.0.11",
    "@types/node": "^25.0.3",
    "@types/shelljs": "^0.10.0",
    "@types/webpack-env": "^1.18.5",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "@vitest/browser": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "@vue/babel-plugin-jsx": "^2.0.1",
    "@vue/compiler-sfc": "^3.5.26",
    "@vue/component-compiler-utils": "^3.3.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/runtime-core": "^3.5.26",
    "@vue/runtime-dom": "^3.5.26",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "chalk": "^5.6.2",
    "codemirror": "^6.0.1",
    "cpy": "^12.1.0",
    "css-tree": "^3.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-no-explicit-type-exports": "^0.12.0",
    "eslint-plugin-oxlint": "^1.33.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^10.6.2",
    "fetch-jsonp": "^1.3.0",
    "fs-extra": "^11.3.3",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "lodash": "^4.17.21",
    "markdown-it-container": "^4.0.0",
    "markdown-it-multimd-table": "^4.1.1",
    "nanoid": "^5.1.6",
    "oxlint": "^1.34.0",
    "playwright": "^1.51.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "pretty-quick": "^4.2.2",
    "qs": "^6.14.1",
    "resize-observer-polyfill": "^1.5.1",
    "rollup": "^4.53.5",
    "rollup-plugin-banner": "^0.2.1",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-scss": "^4.0.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "rollup-plugin-vue": "^6.0.0",
    "sass": "^1.97.0",
    "shelljs": "^0.10.0",
    "stylelint": "^16.26.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^2.7.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.13.0",
    "sucrase": "^3.35.0",
    "tailwindcss": "^3.4.0",
    "transliteration": "^2.3.5",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.2.0",
    "tsc-alias": "^1.8.10",
    "typescript": "~6.0.3",
    "typescript-transform-paths": "^3.4.7",
    "unplugin-vue-components": "^30.0.0",
    "unplugin-vue-define-options": "^3.1.1",
    "vfile-message": "^4.0.3",
    "vite": "^7.3.0",
    "vite-plugin-prismjs": "^0.0.11",
    "vite-plugin-resolve-extension-vue": "^0.1.0",
    "vitepress": "^1.2.3",
    "vitest": "^4.0.16",
    "vue": "^3.5.26",
    "vue-router": "^4.4.5",
    "vue-template-compiler": "^2.7.16",
    "vue-tsc": "^3.1.8",
    "vue-types": "^6.0.0",
    "yargs": "^18.0.0"
  },
  "resolutions": {
    "vue": "3.5.26",
    "@vue/runtime-core": "3.5.26",
    "@vue/runtime-dom": "3.5.26",
    "@vue/compiler-core": "3.5.26",
    "@vue/compiler-dom": "3.5.26",
    "@vue/compiler-sfc": "3.5.26",
    "@vue/reactivity": "3.5.26",
    "@vue/shared": "3.5.26",
    "@typescript-eslint/utils": "8.65.0",
    "sass": "1.97.0",
    "typescript-eslint": "8.65.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue}": "oxlint",
    "**/*.scss": [
      "stylelint --fix"
    ]
  },
  "dependencies": {}
}
