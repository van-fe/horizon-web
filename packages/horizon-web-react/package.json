{
  "name": "@aurora/horizon-web-react",
  "version": "1.0.0",
  "description": "React renderer for Horizon Web.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "types"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "bun run build:dist && bun run build:types",
    "build:dist": "bunx --bun vite build",
    "build:types": "rm -rf types && tsc -d --pretty --emitDeclarationOnly --declarationDir ./types",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun run --bun vitest run --config ./vitest.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@aurora/core": "workspace:*",
    "@aurora/horizon-web-core": "workspace:*",
    "@aurora/theme": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "license": "ISC"
}
