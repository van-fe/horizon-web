{
  "compilerOptions": {
    "baseUrl": "./",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ES2022",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "webpack-env",
      "node",
      "vite/client"
    ],
    "paths": {
      "~/*": [
        "src/*"
      ],
      "@aurora/horizon-web-pad": [
        "../horizon-web-pad/src/index.ts"
      ],
      "@aurora/horizon-web-pad/*": [
        "../horizon-web-pad/src/*"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "docs/**/*.vue", "docs/**/*.ts", "docs/**/*.tsx", "src/vue.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
