{
  "name": "@nio-fe/lego-pad",
  "version": "1.0.0",
  "description": "Adapt @nio-fe/lego for pad mode",
  "main": "lib/index.js",
  "module": "es/index.js",
  "unpkg": "dist/lego-pad-browser.umd.js",
  "types": "es/index.d.ts",
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:dist && pnpm run build:style && pnpm build:ts",
    "build:lib": "bunx --bun vite build",
    "build:dist": "bunx --bun vite build  --config build/vite.browser.config.ts",
    "build:style": "bunx --bun vite build  --config build/vite.style.config.ts",
    "build:ts": "tsc -d --pretty --emitDeclarationOnly -p tsconfig.build.json && pnpm run recorrect:tsc-alias",
    "recorrect:tsc-alias": "tsc ../lego/build/tsc-alias/shared.ts && tsc-alias -p tsconfig.build.json",
    "ts:check": "tsc --noEmit"
  },
  "license": "ISC",
  "files": [
    "dist",
    "lib",
    "json",
    "es"
  ],
  "dependencies": {
    "@nio-fe/shared": "workspace:*"
  },
  "devDependencies": {
    "@nio-fe/lego": "workspace:*",
    "@nio-fe/icon": "^2.11.2"
  }
}
