{
  "name": "@aurora/locale",
  "version": "1.0.0",
  "main": "./dist/locale.cjs",
  "module": "./dist/locale.js",
  "unpkg": "./dist/locale.umd.js",
  "types": "./types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "types"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "bun run build:types && bun run build:js -- --watch",
    "build": "bun run build:types && bun run build:js",
    "build:types": "rm -rf types && tsc -d --emitDeclarationOnly --declarationDir ./types",
    "build:js": "bunx --bun vite build --config vite.config.ts"
  },
  "dependencies": {
    "@aurora/utils": "workspace:*",
    "dayjs": "^1.11.13",
    "lodash-es": "^4.17.21"
  }
}
