{
  "name": "@aurora/colors",
  "version": "1.0.0",
  "main": "./dist/colors.cjs",
  "module": "./dist/colors.js",
  "unpkg": "./dist/colors.umd.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "dev": "vite build --watch",
    "build": "bunx --bun vite build && bun run build:browser && bun run build:ts",
    "build:browser": "bunx --bun vite build --config vite.browser.config.ts",
    "build:ts": "tsc -d --pretty --emitDeclarationOnly --declarationDir ./types"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@aurora/utils": "workspace:*",
    "@ctrl/tinycolor": "^3.6.0"
  }
}
