{
  "name": "@aurora/theme",
  "version": "1.0.0",
  "description": "Shared visual contracts and token utilities for Aurora component products.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles/avatar": "./styles/components/avatar/index.scss",
    "./styles/avatar-variables": "./styles/components/avatar/variables.scss",
    "./styles/badge": "./styles/components/badge/index.scss",
    "./styles/badge-variables": "./styles/components/badge/variables.scss",
    "./styles/button": "./styles/components/button/index.scss",
    "./styles/button-variables": "./styles/components/button/variables.scss",
    "./styles/divider": "./styles/components/divider/index.scss",
    "./styles/divider-variables": "./styles/components/divider/variables.scss",
    "./styles/foundations": "./styles/foundations.scss",
    "./styles/basic": "./styles/basic/index.scss",
    "./styles/element": "./styles/element/index.scss",
    "./styles/mixins": "./styles/mixins/index.scss",
    "./styles/mixins/*": "./styles/mixins/*.scss",
    "./styles/select": "./styles/components/select/index.scss",
    "./styles/select-input": "./styles/components/select/input.scss",
    "./styles/select-option": "./styles/components/select/option.scss",
    "./styles/select-option-group": "./styles/components/select/option-group.scss",
    "./styles/select-variables": "./styles/components/select/variables.scss",
    "./styles/space": "./styles/components/space/index.scss",
    "./styles/space-variables": "./styles/components/space/variables.scss",
    "./styles/switch": "./styles/components/switch/index.scss",
    "./styles/switch-variables": "./styles/components/switch/variables.scss",
    "./styles/tooltip": "./styles/components/tooltip/index.scss",
    "./styles/tooltip-variables": "./styles/components/tooltip/variables.scss"
  },
  "files": [
    "dist",
    "types",
    "styles"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "bun run build:dist && bun run build:types",
    "build:dist": "bunx --bun vite build",
    "build:types": "rm -rf types && tsc -d --pretty --emitDeclarationOnly --declarationDir ./types",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun run --bun vitest run --config ./vitest.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC"
}
