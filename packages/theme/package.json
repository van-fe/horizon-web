{
  "name": "@aurora/theme",
  "version": "1.0.0",
  "description": "Shared visual contracts and token utilities for Aurora component products.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./assets/empty-default.svg": {
      "types": "./assets/svg.d.ts",
      "default": "./assets/empty-default.svg"
    },
    "./assets/result-not-allowed.svg": {
      "types": "./assets/svg.d.ts",
      "default": "./assets/result-not-allowed.svg"
    },
    "./assets/result-not-found.svg": {
      "types": "./assets/svg.d.ts",
      "default": "./assets/result-not-found.svg"
    },
    "./assets/result-server-error.svg": {
      "types": "./assets/svg.d.ts",
      "default": "./assets/result-server-error.svg"
    },
    "./styles/alert": "./styles/components/alert/index.scss",
    "./styles/alert-variables": "./styles/components/alert/variables.scss",
    "./styles/affix": "./styles/components/affix/index.scss",
    "./styles/affix-variables": "./styles/components/affix/variables.scss",
    "./styles/anchor": "./styles/components/anchor/index.scss",
    "./styles/anchor-variables": "./styles/components/anchor/variables.scss",
    "./styles/avatar": "./styles/components/avatar/index.scss",
    "./styles/avatar-variables": "./styles/components/avatar/variables.scss",
    "./styles/backtop": "./styles/components/backtop/index.scss",
    "./styles/backtop-variables": "./styles/components/backtop/variables.scss",
    "./styles/badge": "./styles/components/badge/index.scss",
    "./styles/badge-variables": "./styles/components/badge/variables.scss",
    "./styles/breadcrumb": "./styles/components/breadcrumb/index.scss",
    "./styles/breadcrumb-variables": "./styles/components/breadcrumb/variables.scss",
    "./styles/button": "./styles/components/button/index.scss",
    "./styles/button-variables": "./styles/components/button/variables.scss",
    "./styles/card": "./styles/components/card/index.scss",
    "./styles/card-variables": "./styles/components/card/variables.scss",
    "./styles/checkbox": "./styles/components/checkbox/index.scss",
    "./styles/checkbox-variables": "./styles/components/checkbox/variables.scss",
    "./styles/collapse": "./styles/components/collapse/index.scss",
    "./styles/collapse-variables": "./styles/components/collapse/variables.scss",
    "./styles/count": "./styles/components/count/index.scss",
    "./styles/count-variables": "./styles/components/count/variables.scss",
    "./styles/container": "./styles/components/container/index.scss",
    "./styles/container-variables": "./styles/components/container/variables.scss",
    "./styles/divider": "./styles/components/divider/index.scss",
    "./styles/divider-variables": "./styles/components/divider/variables.scss",
    "./styles/dialog": "./styles/components/dialog/index.scss",
    "./styles/dialog-variables": "./styles/components/dialog/variables.scss",
    "./styles/drawer": "./styles/components/drawer/index.scss",
    "./styles/drawer-variables": "./styles/components/drawer/variables.scss",
    "./styles/dropdown": "./styles/components/dropdown/index.scss",
    "./styles/dropdown-variables": "./styles/components/dropdown/variables.scss",
    "./styles/empty": "./styles/components/empty/index.scss",
    "./styles/empty-variables": "./styles/components/empty/variables.scss",
    "./styles/float-button": "./styles/components/float-button/index.scss",
    "./styles/float-button-variables": "./styles/components/float-button/variables.scss",
    "./styles/form": "./styles/components/form/index.scss",
    "./styles/form-variables": "./styles/components/form/variables.scss",
    "./styles/input": "./styles/components/input/index.scss",
    "./styles/input-variables": "./styles/components/input/variables.scss",
    "./styles/input-number": "./styles/components/input-number/index.scss",
    "./styles/input-number-variables": "./styles/components/input-number/variables.scss",
    "./styles/link": "./styles/components/link/index.scss",
    "./styles/link-variables": "./styles/components/link/variables.scss",
    "./styles/mask": "./styles/components/mask/index.scss",
    "./styles/mask-variables": "./styles/components/mask/variables.scss",
    "./styles/layout": "./styles/components/layout/index.scss",
    "./styles/layout-variables": "./styles/components/layout/variables.scss",
    "./styles/pagination": "./styles/components/pagination/index.scss",
    "./styles/pagination-variables": "./styles/components/pagination/variables.scss",
    "./styles/popover": "./styles/components/popover/index.scss",
    "./styles/popover-variables": "./styles/components/popover/variables.scss",
    "./styles/popconfirm": "./styles/components/popconfirm/index.scss",
    "./styles/popconfirm-variables": "./styles/components/popconfirm/variables.scss",
    "./styles/foundations": "./styles/foundations.scss",
    "./styles/basic": "./styles/basic/index.scss",
    "./styles/element": "./styles/element/index.scss",
    "./styles/mixins": "./styles/mixins/index.scss",
    "./styles/mixins/*": "./styles/mixins/*.scss",
    "./styles/progress": "./styles/components/progress/index.scss",
    "./styles/progress-variables": "./styles/components/progress/variables.scss",
    "./styles/rate": "./styles/components/rate/index.scss",
    "./styles/rate-variables": "./styles/components/rate/variables.scss",
    "./styles/radio": "./styles/components/radio/index.scss",
    "./styles/radio-variables": "./styles/components/radio/variables.scss",
    "./styles/result": "./styles/components/result/index.scss",
    "./styles/result-variables": "./styles/components/result/variables.scss",
    "./styles/select": "./styles/components/select/index.scss",
    "./styles/select-input": "./styles/components/select/input.scss",
    "./styles/select-option": "./styles/components/select/option.scss",
    "./styles/select-option-group": "./styles/components/select/option-group.scss",
    "./styles/select-variables": "./styles/components/select/variables.scss",
    "./styles/segmented": "./styles/components/segmented/index.scss",
    "./styles/segmented-variables": "./styles/components/segmented/variables.scss",
    "./styles/skeleton": "./styles/components/skeleton/index.scss",
    "./styles/skeleton-variables": "./styles/components/skeleton/variables.scss",
    "./styles/spin": "./styles/components/spin/index.scss",
    "./styles/spin-variables": "./styles/components/spin/variables.scss",
    "./styles/time": "./styles/components/time/index.scss",
    "./styles/time-variables": "./styles/components/time/variables.scss",
    "./styles/slider": "./styles/components/slider/index.scss",
    "./styles/slider-variables": "./styles/components/slider/variables.scss",
    "./styles/space": "./styles/components/space/index.scss",
    "./styles/space-variables": "./styles/components/space/variables.scss",
    "./styles/statistic": "./styles/components/statistic/index.scss",
    "./styles/statistic-variables": "./styles/components/statistic/variables.scss",
    "./styles/steps": "./styles/components/steps/index.scss",
    "./styles/steps-variables": "./styles/components/steps/variables.scss",
    "./styles/switch": "./styles/components/switch/index.scss",
    "./styles/switch-variables": "./styles/components/switch/variables.scss",
    "./styles/tabs": "./styles/components/tabs/index.scss",
    "./styles/tabs-variables": "./styles/components/tabs/variables.scss",
    "./styles/tooltip": "./styles/components/tooltip/index.scss",
    "./styles/tooltip-variables": "./styles/components/tooltip/variables.scss",
    "./styles/timeline": "./styles/components/timeline/index.scss",
    "./styles/timeline-variables": "./styles/components/timeline/variables.scss",
    "./styles/typography": "./styles/components/typography/index.scss",
    "./styles/typography-variables": "./styles/components/typography/variables.scss"
  },
  "files": [
    "assets",
    "dist",
    "types",
    "styles"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "bun run build:dist && bun run build:types",
    "build:dist": "bunx --bun vite build",
    "build:types": "rm -rf types && tsc -d --pretty --emitDeclarationOnly --declarationDir ./types",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun run --bun vitest run --config ./vitest.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC"
}
