{
  "compilerOptions": {
    "target": "es2021",
    "module": "es2022",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": [
      "webpack-env",
      "node"
    ],
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost",
      "browser"
    ],
    "paths": {
      "*": ["./*"],
      "~/*": ["./src/*"],
      "@/*": ["./node_modules/*"],
      "@root/*": ["../../*"]
    },
  },
  "include": [
    "src/**/*.ts",
  ],
  "exclude": [
    "types",
    "node_modules"
  ]
}
