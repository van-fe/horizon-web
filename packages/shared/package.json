{
  "name": "@nio-fe/shared",
  "version": "1.0.0",
  "description": "For @nio-fe/lego. Include a series of functions for developing.",
  "main": "dist/shared.cjs",
  "module": "dist/shared.js",
  "unpkg": "dist/shared.umd.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/shared.js",
      "require": "./dist/shared.cjs",
      "types": "./types/index.d.ts"
    },
    "./plugins": "./plugins/index.js"
  },
  "scripts": {
    "dev": "pnpm run build:types && pnpm run build:plugin && vite build -- --watch",
    "build": "pnpm run build:dist && pnpm run build:types && pnpm run build:plugin",
    "build:dist": "bunx --bun vite build",
    "build:plugin": "tsc ./plugins/index.ts",
    "build:types": "rm -rf types && tsc -d --pretty --emitDeclarationOnly --declarationDir ./types",
    "rm": "rm -rf dist && rm -rf plugins/*.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "dist",
    "types"
  ],
  "devConfig": {
    "watch": false
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@vueuse/core": "^9.6.0",
    "lodash": "^4.17.21"
  }
}
